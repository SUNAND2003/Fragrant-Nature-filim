# Fragrant Nature API server — copy to .env and fill in

PORT=4000

# MongoDB (Atlas mongodb+srv://... or local mongodb://127.0.0.1:27017/fragrant-nature)
MONGODB_URI=

# JWT signing secret — any long random string
JWT_SECRET=change-me-to-a-long-random-string

# Admin account created/updated by `npm run seed`
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin1234

# Cloudinary (optional — falls back to local server/uploads storage if empty)
CLOUDINARY_URL=
# or fill these individually:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
